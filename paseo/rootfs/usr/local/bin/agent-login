#!/usr/bin/env bash
#
# Show which agent CLIs are logged in, and exactly what to type for the ones
# that are not. Run it from a terminal pane in the Paseo UI.
#
# Credentials land under /data/home and survive restarts and add-on updates, so
# each of these is a one-time job.

set -euo pipefail

bold()  { printf '\033[1m%s\033[0m\n' "$*"; }
dim()   { printf '\033[2m%s\033[0m\n' "$*"; }

state() { # state <label> <ok|no> <detail>
    if [[ "$2" == ok ]]; then
        printf '  \033[32m%-9s logged in\033[0m  %s\n' "$1" "${3:-}"
    else
        printf '  \033[33m%-9s not set up\033[0m  %s\n' "$1" "${3:-}"
    fi
}

bold "Agent authentication"
echo

# Claude Code -- credentials in $CLAUDE_CONFIG_DIR, or an API key in the env.
if [[ -n "${ANTHROPIC_API_KEY:-}" ]]; then
    state claude ok "via ANTHROPIC_API_KEY"
elif [[ -s "${CLAUDE_CONFIG_DIR}/.credentials.json" ]] \
   || compgen -G "${CLAUDE_CONFIG_DIR}/*.json" >/dev/null 2>&1; then
    state claude ok "config present in ${CLAUDE_CONFIG_DIR}"
else
    state claude no
fi

# Codex -- ask it directly.
if codex login status >/dev/null 2>&1; then
    state codex ok
elif [[ -n "${OPENAI_API_KEY:-}" ]]; then
    state codex ok "via OPENAI_API_KEY"
else
    state codex no
fi

# OpenCode keeps credentials in its own store.
if opencode auth list 2>/dev/null | grep -qiE '^\s*[a-z]' ; then
    state opencode ok
else
    state opencode no
fi

if [[ -n "${GEMINI_API_KEY:-}${GOOGLE_API_KEY:-}" ]]; then
    state gemini ok "via API key"
elif [[ -d "${HOME}/.gemini" ]] && compgen -G "${HOME}/.gemini/*.json" >/dev/null 2>&1; then
    state gemini ok "config present in ${HOME}/.gemini"
else
    state gemini no
fi

if [[ -d "${HOME}/.copilot" ]]; then
    state copilot ok "config present in ${HOME}/.copilot"
else
    state copilot no
fi

cat <<'EOF'

How to log in
-------------

  claude          then /login, and paste the code back. Works headless.
                  Or: claude setup-token   (long-lived token, needs a subscription)

  codex login     opens a browser flow with a LOCAL callback, which does not
                  work from a remote container unless you tunnel it:
                      ssh -L 1455:localhost:1455 <you>@<ha-host>
                  Simpler, no tunnel needed:
                      printenv OPENAI_API_KEY | codex login --with-api-key
                  Check with: codex login status

  opencode auth login     interactive provider picker. Works headless.

  copilot login   device-code flow: open the URL, type the code. Works headless.

  gemini          has NO login subcommand. Either pick "Login with Google" in
                  the interactive TUI (browser callback, same tunnel caveat as
                  codex), or supply an API key -- see below.

API keys without any interactive flow
-------------------------------------
Set the add-on's `provider_env` option to a JSON object and restart:

    {"GEMINI_API_KEY": "...", "OPENAI_API_KEY": "...", "ANTHROPIC_API_KEY": "..."}

Those are exported to the daemon and to every agent it spawns. Note they are
stored in plaintext in the add-on options; logging in interactively avoids
keeping a key on disk at all, so prefer it where the flow works.
EOF
