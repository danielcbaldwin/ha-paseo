#!/usr/bin/env bash
#
# Home Assistant add-on entrypoint for Paseo.
#
# Runs as root. Translates /data/options.json into environment variables and
# Paseo config, prepares the persistent directories, then hands off to the
# upstream entrypoint which does its own first-run setup and drops to uid 1000.
#
# Nothing here starts the daemon itself -- upstream owns that.

set -euo pipefail

UPSTREAM_ENTRYPOINT=/usr/local/bin/paseo-docker-entrypoint
PASEO_UID=1000
PASEO_GID=1000
CHOWN_MARKER=/data/.ha-paseo-chowned-v1

log()   { printf '[ha-paseo] %s\n' "$*"; }
warn()  { printf '[ha-paseo] WARNING: %s\n' "$*" >&2; }
fatal() { printf '[ha-paseo] FATAL: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Options
#
# Supervisor writes /data/options.json. When it is absent (local `docker run`
# testing) fall back to an empty object so every option takes its default and
# plain -e environment variables still work.
# ---------------------------------------------------------------------------
OPTIONS_FILE=/data/options.json
if [[ ! -f "$OPTIONS_FILE" ]]; then
    OPTIONS_FILE=/tmp/ha-paseo-options.json
    printf '{}\n' > "$OPTIONS_FILE"
    log "no /data/options.json (not running under Supervisor); using defaults"
fi

opt_str() { jq -r --arg d "$2" "$1 // \$d" "$OPTIONS_FILE"; }

# Explicitly null-checked rather than using jq's `//`, which treats BOTH null
# and false as absent -- so `.x // true` yields true even when x is literally
# false, and every boolean option defaulting to true would ignore being turned
# off. That silently defeated `expose_ha_config: false`, among others.
opt_json() { jq -c "if ($1) == null then ($2) else ($1) end" "$OPTIONS_FILE"; }

password="$(opt_str '.password' '')"
hostnames="$(jq -r '(.hostnames // []) | join(",")' "$OPTIONS_FILE")"
log_level="$(opt_str '.log_level' 'info')"
connection_mode="$(opt_str '.connection_mode' 'relay')"
relay_endpoint="$(opt_str '.relay_endpoint' '')"
relay_public_endpoint="$(opt_str '.relay_public_endpoint' '')"
relay_use_tls="$(opt_json '.relay_use_tls' 'true')"
relay_public_use_tls="$(opt_json '.relay_public_use_tls' 'true')"
app_base_url="$(opt_str '.app_base_url' 'https://app.paseo.sh')"
workspace_root="$(opt_str '.workspace_root' '/share/paseo/workspace')"
expose_ha_config="$(opt_json '.expose_ha_config' 'true')"
ha_mcp_url="$(opt_str '.ha_mcp_url' 'http://supervisor/core/mcp_server/sse')"

# Supervisor's option schema has no JSON type, so provider_overrides arrives as
# a string. Accept either form, and fall back to {} on unparseable input rather
# than letting a typo in the config tab stop the add-on from booting.
provider_overrides="$(jq -c '
    (.provider_overrides // {}) as $p
    | if ($p | type) == "string"
      then (($p | fromjson?) // {})
      else $p end
' "$OPTIONS_FILE")"
if [[ "$provider_overrides" == "{}" ]] \
   && [[ -n "$(opt_str '.provider_overrides' '')" ]] \
   && [[ "$(opt_str '.provider_overrides' '')" != "{}" ]]; then
    warn "provider_overrides is not valid JSON; ignoring it"
fi
extra_npm="$(jq -r '(.extra_npm_packages // []) | join(" ")' "$OPTIONS_FILE")"
extra_apt="$(jq -r '(.extra_apt_packages // []) | join(" ")' "$OPTIONS_FILE")"
auto_update_agents="$(opt_json '.auto_update_agents' 'false')"
print_pairing_link="$(opt_json '.print_pairing_link' 'true')"

# API keys for providers whose login flow does not work well headless -- Gemini
# has no CLI login command at all. Same string-or-object handling as
# provider_overrides.
provider_env="$(jq -c '
    (.provider_env // {}) as $p
    | if ($p | type) == "string"
      then (($p | fromjson?) // {})
      else $p end
' "$OPTIONS_FILE")"

# An explicit -e PASEO_PASSWORD wins, so the image can be exercised locally
# without writing an options file.
if [[ -n "${PASEO_PASSWORD:-}" ]]; then
    password="$PASEO_PASSWORD"
fi

# No password configured? Generate one rather than refusing to start.
#
# Running unauthenticated is not offered: unlike a typical desktop install --
# which binds 127.0.0.1 and is unreachable from the network -- this add-on
# publishes 6767 on the LAN, and the daemon holds a Supervisor token with
# manager rights. Anyone who can reach the port could rewrite automations or
# remove add-ons. Generating a strong password keeps setup zero-effort without
# that trade.
GENERATED_PASSWORD_FILE=/data/.paseo-generated-password

# Write the generated password back into the add-on's own options, so it shows
# up in the Configuration tab like any password you had set yourself. Without
# this the only copy is a log line, and there is no way to look it up later
# short of a shell -- which you cannot get without first connecting, which
# needs the password.
persist_password_to_options() { # persist_password_to_options <password>
    local pw="$1" base="${SUPERVISOR_API_BASE:-http://supervisor}" current body
    [[ -n "${SUPERVISOR_TOKEN:-}" ]] || return 1

    current="$(curl -fsS --max-time 10 \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        "${base}/addons/self/info" 2>/dev/null | jq -c '.data.options // empty')" || return 1
    [[ -n "$current" ]] || return 1

    # Read-merge-write, sending the FULL option set back. Supervisor replaces
    # options wholesale, so posting just {"password": ...} would silently wipe
    # every other setting.
    body="$(jq -c --arg p "$pw" '{options: (. + {password: $p})}' <<<"$current")" || return 1

    curl -fsS --max-time 10 -X POST \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "$body" "${base}/addons/self/options" >/dev/null 2>&1
}

if [[ -z "$password" ]]; then
    # 28 alphanumerics. dd/base64/cut avoids the SIGPIPE that `head -c` on
    # /dev/urandom would trigger under pipefail.
    generated="$(dd if=/dev/urandom bs=32 count=1 2>/dev/null \
                 | base64 | tr -dc 'A-Za-z0-9' | cut -c1-28)"
    if [[ "${#generated}" -lt 20 ]]; then
        fatal "could not generate a password; set one in the Configuration tab"
    fi

    if persist_password_to_options "$generated"; then
        password="$generated"
        # The options field is now the single source of truth; drop any older
        # on-disk copy so the two cannot disagree.
        rm -f "$GENERATED_PASSWORD_FILE" 2>/dev/null || true
        log ""
        log "============== Generated Paseo password =============="
        log "  ${password}"
        log ""
        log "  No password was set, so one was generated and written into the"
        log "  add-on's 'password' option -- you can see it in the"
        log "  Configuration tab. To change it, edit it there. To get a fresh"
        log "  one, clear the field and restart."
        log "======================================================"
        log ""
    elif [[ -s "$GENERATED_PASSWORD_FILE" ]]; then
        # Supervisor unreachable: keep using the password already generated
        # rather than handing out a new one on every restart.
        password="$(cat "$GENERATED_PASSWORD_FILE")"
        log "no password configured; reusing the one in ${GENERATED_PASSWORD_FILE}"
    else
        password="$generated"
        if (umask 077; printf '%s' "$password" > "$GENERATED_PASSWORD_FILE") 2>/dev/null; then
            chown "${PASEO_UID}:${PASEO_GID}" "$GENERATED_PASSWORD_FILE" 2>/dev/null || true
        else
            warn "could not save the generated password; a new one will be"
            warn "  generated on every restart until you set one yourself"
        fi
        log ""
        log "============== Generated Paseo password =============="
        log "  ${password}"
        log ""
        log "  Could not write it into the add-on options, so it is stored in"
        log "  ${GENERATED_PASSWORD_FILE} instead. Delete that file and"
        log "  restart to get a fresh one, or set 'password' yourself."
        log "======================================================"
        log ""
    fi
fi

# --- How clients reach this daemon ------------------------------------------
#   relay        Paseo's hosted relay. Works with no VPN or router changes; a
#                join link is printed to the add-on log.
#   local        No relay. Direct connections only, from the LAN or a VPN.
#   custom_relay A relay you run yourself (the image ships @getpaseo/relay).
case "$connection_mode" in
    relay)
        relay_enabled=true
        relay_endpoint=""          # empty => Paseo's hosted relay
        relay_public_endpoint=""
        ;;
    local)
        relay_enabled=false
        relay_endpoint=""
        relay_public_endpoint=""
        ;;
    custom_relay)
        if [[ -z "$relay_endpoint" ]]; then
            # Falling back to the hosted relay here would quietly send traffic
            # somewhere the user explicitly chose not to use.
            warn "connection_mode is 'custom_relay' but relay_endpoint is empty;"
            warn "  falling back to 'local' (direct connections only)"
            relay_enabled=false
            connection_mode=local
        else
            relay_enabled=true
        fi
        ;;
    *)
        warn "unknown connection_mode '${connection_mode}'; falling back to 'local'"
        relay_enabled=false
        connection_mode=local
        relay_endpoint=""
        relay_public_endpoint=""
        ;;
esac
log "connection mode: ${connection_mode}"

export PASEO_PASSWORD="$password"
export PASEO_LOG_LEVEL="$log_level"

# Exported here so the daemon and every agent it spawns inherit them. Key names
# are validated -- an options file is not a place to accept arbitrary shell.
# Values are never logged.
while IFS= read -r kv; do
    if [[ -z "$kv" ]]; then
        continue
    fi
    key="${kv%%=*}"
    if [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        export "${key}=${kv#*=}"
        log "exported provider_env ${key}"
    else
        warn "ignoring provider_env entry with an invalid name: ${key}"
    fi
done < <(jq -r 'to_entries[] | "\(.key)=\(.value)"' <<<"$provider_env")
if [[ -n "$hostnames" ]]; then
    export PASEO_HOSTNAMES="$hostnames"
fi

# ---------------------------------------------------------------------------
# Persistent directories
# ---------------------------------------------------------------------------
# Create a directory and hand it to the paseo user, including any intermediate
# components mkdir -p had to create. Without the walk, `mkdir -p
# /share/paseo/workspace` leaves /share/paseo owned by root and the daemon
# cannot create siblings under it.
#
# /data and /share themselves are Supervisor mount points and are left alone.
ensure_dir() {
    local path="$1" current="" part parts
    mkdir -p "$path"
    IFS=/ read -ra parts <<< "${path#/}"
    for part in "${parts[@]}"; do
        current="${current}/${part}"
        case "$current" in
            /data|/share|/config|/homeassistant|/ssl) continue ;;
        esac
        if [[ -d "$current" ]] \
           && [[ "$(stat -c '%u:%g' "$current")" != "${PASEO_UID}:${PASEO_GID}" ]]; then
            chown "${PASEO_UID}:${PASEO_GID}" "$current"
        fi
    done
}

ensure_dir /data/home
ensure_dir "$workspace_root"
ensure_dir /share/paseo/bin

# A restored backup or a hand-edited /share can leave files owned by the wrong
# uid. Do the expensive recursive pass once, then never again -- worktrees get
# large and this runs on every boot.
if [[ ! -f "$CHOWN_MARKER" ]]; then
    log "first run: normalising ownership of /data/home"
    chown -R "${PASEO_UID}:${PASEO_GID}" /data/home || warn "recursive chown of /data/home failed"
    touch "$CHOWN_MARKER"
fi

# ---------------------------------------------------------------------------
# Optional extra packages
#
# Neither is fatal: a transient network failure at boot should not take the
# add-on down, it should just log and carry on.
# ---------------------------------------------------------------------------
if [[ -n "$extra_apt" ]]; then
    log "installing extra apt packages: $extra_apt"
    if apt-get update -qq; then
        # shellcheck disable=SC2086
        apt-get install -y --no-install-recommends $extra_apt \
            || warn "one or more extra_apt_packages failed to install"
    else
        warn "apt-get update failed; skipping extra_apt_packages"
    fi
    rm -rf /var/lib/apt/lists/*
fi

if [[ -n "$extra_npm" ]]; then
    log "installing extra npm packages: $extra_npm"
    # shellcheck disable=SC2086
    gosu "${PASEO_UID}:${PASEO_GID}" npm install -g --no-fund --no-audit $extra_npm \
        || warn "one or more extra_npm_packages failed to install"
fi

# Opt-in: pull the latest agent CLIs at every boot instead of using the versions
# pinned in the image. Costs a slow, network-dependent start and gives up
# reproducibility, which is why it is off by default.
if [[ "$auto_update_agents" == "true" ]]; then
    log "auto_update_agents is on; updating agent CLIs to latest"
    gosu "${PASEO_UID}:${PASEO_GID}" /usr/local/bin/update-agents all \
        || warn "agent auto-update failed; continuing with the versions already installed"
fi

# ---------------------------------------------------------------------------
# Paseo config
#
# Seeded as the paseo user so ownership is right, and merged rather than
# overwritten so edits made from the app survive a restart.
# ---------------------------------------------------------------------------
SEED_RELAY="$relay_enabled" \
SEED_RELAY_ENDPOINT="$relay_endpoint" \
SEED_RELAY_PUBLIC_ENDPOINT="$relay_public_endpoint" \
SEED_RELAY_USE_TLS="$relay_use_tls" \
SEED_RELAY_PUBLIC_USE_TLS="$relay_public_use_tls" \
SEED_APP_BASE_URL="$app_base_url" \
SEED_WORKTREE_ROOT="$workspace_root" \
SEED_PROVIDER_OVERRIDES="$provider_overrides" \
gosu "${PASEO_UID}:${PASEO_GID}" /usr/local/bin/ha-paseo-seed-config

# ---------------------------------------------------------------------------
# Home Assistant wiring for the agents
# ---------------------------------------------------------------------------
if [[ "$expose_ha_config" == "true" ]]; then
    if [[ -d /homeassistant ]]; then
        log "Home Assistant config is mapped at /homeassistant"
        HA_MCP_URL="$ha_mcp_url" \
        gosu "${PASEO_UID}:${PASEO_GID}" /usr/local/bin/ha-paseo-postboot seed-ha-config \
            || warn "failed to seed Home Assistant agent config"
    else
        warn "expose_ha_config is on but /homeassistant is not mapped"
    fi
fi

# Anything needing a live daemon -- registering the /homeassistant workspace and
# printing the pairing link -- has to wait until after the handoff below, so it
# runs in the background polling the unauthenticated /api/health route.
EXPOSE_HA_CONFIG="$expose_ha_config" \
PRINT_PAIRING_LINK="$print_pairing_link" \
RELAY_ENABLED="$relay_enabled" \
CONNECTION_MODE="$connection_mode" \
gosu "${PASEO_UID}:${PASEO_GID}" /usr/local/bin/ha-paseo-postboot after-start &

log "starting Paseo (state in ${PASEO_HOME}, workspaces in ${workspace_root})"

# Hand off. Upstream performs its first-run volume setup as root and then drops
# to uid 1000 via gosu; replacing that would mean reimplementing it.
exec "$UPSTREAM_ENTRYPOINT" "$@"
