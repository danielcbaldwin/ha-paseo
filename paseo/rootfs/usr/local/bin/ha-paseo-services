#!/usr/bin/env bash
#
# Run user-defined background services alongside the Paseo daemon.
#
# Two sources, both optional:
#
#   1. The `services` add-on option -- a list of shell commands.
#   2. Any executable in /share/paseo/services/ -- drop a script in, no config
#      edit needed. Handy for things like a TeamClaude proxy that you also want
#      to version outside the add-on.
#
# Each service is supervised: if it exits it is restarted with exponential
# backoff (2s doubling to 60s), so a broken command cannot hot-loop the box.
# Output is prefixed and goes to the add-on log alongside everything else.
#
# Deliberately not `set -e`: one bad service must never stop the others, and
# must never stop the daemon.

set -uo pipefail

SERVICES_DIR=/share/paseo/services

log() { printf '[ha-paseo] %s\n' "$*"; }

# supervise <name> <command>
supervise() {
    local name="$1" cmd="$2"
    (
        local delay=2
        while true; do
            printf '[svc:%s] starting\n' "$name"
            # A login shell, so /share/paseo/bin and the npm override dir are on
            # PATH exactly as they are in a Paseo terminal pane.
            bash -lc "$cmd" 2>&1 | sed -u "s/^/[svc:${name}] /"
            printf '[svc:%s] exited; restarting in %ss\n' "$name" "$delay"
            sleep "$delay"
            if (( delay < 60 )); then
                delay=$(( delay * 2 ))
                (( delay > 60 )) && delay=60
            fi
        done
    ) &
    log "service '${name}' started (pid $!)"
}

started=0
declare -A used_names=()

# Names come from the command's first word, so `sh -c ...` twice would produce
# two services both logging as [svc:sh]. Disambiguate rather than leave the log
# unreadable.
# Returns via $UNIQUE_NAME rather than stdout on purpose: called as
# $(unique_name ...) it would run in a subshell, and the used_names updates
# would be discarded, so every name would collide again.
UNIQUE_NAME=""
unique_name() {
    local base="$1" name="$1" n=1
    while [[ -n "${used_names[$name]:-}" ]]; do
        n=$(( n + 1 ))
        name="${base}-${n}"
    done
    used_names["$name"]=1
    UNIQUE_NAME="$name"
}

# --- from the add-on option -------------------------------------------------
# SERVICES_JSON is a JSON array of command strings, passed in by the entrypoint.
if [[ -n "${SERVICES_JSON:-}" ]]; then
    idx=0
    while IFS= read -r cmd; do
        [[ -n "$cmd" ]] || continue
        idx=$(( idx + 1 ))
        # Name it after the command's first word, which reads far better in the
        # log than "service 3".
        name="$(awk '{print $1}' <<<"$cmd" | xargs -r basename 2>/dev/null)"
        [[ -n "$name" ]] || name="service${idx}"
        unique_name "$name"
        supervise "$UNIQUE_NAME" "$cmd"
        started=$(( started + 1 ))
    done < <(jq -r '.[]? | select(type == "string")' <<<"$SERVICES_JSON" 2>/dev/null)
fi

# --- from the drop-in directory --------------------------------------------
if [[ -d "$SERVICES_DIR" ]]; then
    for script in "$SERVICES_DIR"/*; do
        [[ -f "$script" ]] || continue
        if [[ ! -x "$script" ]]; then
            log "WARNING: ${script} is not executable; skipping (chmod +x it)"
            continue
        fi
        unique_name "$(basename "$script")"
        supervise "$UNIQUE_NAME" "$script"
        started=$(( started + 1 ))
    done
fi

if (( started > 0 )); then
    log "${started} background service(s) running"
fi
