#!/usr/bin/env bash
#
# Materialise the `shims` add-on option into real executables.
#
# A shim intercepts a command name (typically `claude`) so every caller goes
# through a wrapper -- agents spawned by the daemon, terminal panes, everything.
# A shell alias cannot do this: aliases live only in interactive shells and are
# not inherited across execve, which is why `teamclaude alias --install` has no
# effect on an agent multiplexer.
#
# Shims are written to a container-internal directory that is FIRST on PATH and
# regenerated on every start. Nothing is written to /share or /data, so removing
# the option removes the shim.
#
# Input: SHIMS_JSON, a JSON array of {name, command, passthrough[]}.

set -uo pipefail

SHIM_DIR=/run/ha-paseo/shims

log()  { printf '[ha-paseo] %s\n' "$*"; }
warn() { printf '[ha-paseo] WARNING: %s\n' "$*" >&2; }

rm -rf "$SHIM_DIR"
mkdir -p "$SHIM_DIR"

[[ -n "${SHIMS_JSON:-}" ]] || exit 0

count=0
while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue

    name="$(jq -r '.name // empty' <<<"$entry")"
    command_line="$(jq -r '.command // empty' <<<"$entry")"

    if [[ -z "$name" || -z "$command_line" ]]; then
        warn "shim entry needs both 'name' and 'command'; skipping: ${entry}"
        continue
    fi
    # A shim called ../something would escape the directory.
    if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
        warn "invalid shim name '${name}'; skipping"
        continue
    fi

    # Arguments that should bypass the wrapper entirely. Paseo probes providers
    # with `--version` and `auth status` concurrently on every
    # provider-features request; routing those through a proxy makes the daemon
    # wait on it and can stall its websocket.
    passthrough="$(jq -r '(.passthrough // []) | map(select(type == "string")) | join("|")' <<<"$entry")"

    {
        printf '#!/usr/bin/env bash\n'
        printf '# Generated by ha-paseo from the `shims` option. Recreated on every\n'
        printf '# start -- edits here are lost. Change the add-on configuration instead.\n'
        printf 'set -u\n\n'
        printf '# Drop the shim directory from PATH before doing anything else, so the\n'
        printf '# wrapped command resolves the REAL %s rather than re-entering this\n' "$name"
        printf '# shim and recursing until the container runs out of processes.\n'
        printf 'PATH="${PATH#%s:}"\n' "$SHIM_DIR"
        printf 'export PATH\n\n'
        printf '# Absolute path to the command being shadowed, for wrappers that want to\n'
        printf '# exec it directly.\n'
        printf 'REAL="$(command -v %s 2>/dev/null || true)"\n' "$name"
        printf 'export REAL\n\n'
        if [[ -n "$passthrough" ]]; then
            printf '# Bypass the wrapper for probe-style invocations.\n'
            printf 'case "${1:-}" in\n'
            printf '  %s)\n' "$passthrough"
            printf '    if [[ -n "$REAL" ]]; then exec "$REAL" "$@"; fi ;;\n'
            printf 'esac\n\n'
        fi
        printf 'exec %s "$@"\n' "$command_line"
    } > "${SHIM_DIR}/${name}"

    chmod 0755 "${SHIM_DIR}/${name}"
    count=$(( count + 1 ))
    log "shim '${name}' -> ${command_line}"
done < <(jq -c '.[]? | select(type == "object")' <<<"$SHIMS_JSON" 2>/dev/null)

if (( count > 0 )); then
    log "${count} shim(s) installed in ${SHIM_DIR} (first on PATH)"
fi
