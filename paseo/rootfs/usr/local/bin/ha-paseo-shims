#!/usr/bin/env bash
#
# Materialise the `shims` add-on option into real executables.
#
# A shim intercepts a command name (typically `claude`) so every caller goes
# through a wrapper -- agents spawned by the daemon, terminal panes, everything.
# A shell alias cannot do this: aliases live only in interactive shells and are
# not inherited across execve, which is why `teamclaude alias --install` has no
# effect on an agent multiplexer.
#
# Shims are written to a container-internal directory that is FIRST on PATH and
# regenerated on every start. Nothing is written to /share or /data, so removing
# the option removes the shim.
#
# Input: SHIMS_JSON, a JSON array of {name, command, passthrough[]}.

set -uo pipefail

SHIM_DIR=/run/ha-paseo/shims

log()  { printf '[ha-paseo] %s\n' "$*"; }
warn() { printf '[ha-paseo] WARNING: %s\n' "$*" >&2; }

rm -rf "$SHIM_DIR"
mkdir -p "$SHIM_DIR"

[[ -n "${SHIMS_JSON:-}" ]] || exit 0

count=0
while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue

    name="$(jq -r '.name // empty' <<<"$entry")"
    command_line="$(jq -r '.command // empty' <<<"$entry")"
    env_from="$(jq -r '.env_from // empty' <<<"$entry")"
    script_body="$(jq -r '.script // empty' <<<"$entry")"
    require_port="$(jq -r '.require_port // empty' <<<"$entry")"
    target="$(jq -r '.target // empty' <<<"$entry")"

    # An absolute target says exactly which binary is being wrapped. It removes
    # PATH resolution from the shim entirely, so recursion is impossible rather
    # than merely guarded against, and a typo fails HERE, in the log, instead of
    # as a mysterious hang at runtime.
    if [[ -n "$target" ]]; then
        if [[ "$target" != /* ]]; then
            warn "shim target '${target}' must be an absolute path; skipping"
            continue
        fi
        if [[ ! -x "$target" ]]; then
            warn "shim target '${target}' does not exist or is not executable; skipping"
            continue
        fi
        [[ -n "$name" ]] || name="$(basename "$target")"
        if [[ "$(dirname "$target")" == "$SHIM_DIR" ]]; then
            warn "shim target '${target}' is inside the shim directory; skipping"
            continue
        fi
    fi

    if [[ -z "$name" ]]; then
        warn "shim entry needs a 'name'; skipping: ${entry}"
        continue
    fi
    if [[ -z "$command_line" && -z "$env_from" && -z "$script_body" ]]; then
        warn "shim '${name}' needs one of 'command', 'env_from' or 'script'; skipping"
        continue
    fi
    # A shim called ../something would escape the directory.
    if [[ ! "$name" =~ ^[A-Za-z0-9._-]+$ ]]; then
        warn "invalid shim name '${name}'; skipping"
        continue
    fi

    # Arguments that should bypass the wrapper entirely. Paseo probes providers
    # with `--version` and `auth status` concurrently on every
    # provider-features request; routing those through a proxy makes the daemon
    # wait on it and can stall its websocket.
    passthrough="$(jq -r '(.passthrough // []) | map(select(type == "string")) | join("|")' <<<"$entry")"

    {
        printf '#!/usr/bin/env bash\n'
        printf '# Generated by ha-paseo from the `shims` option. Recreated on every\n'
        printf '# start -- edits here are lost. Change the add-on configuration instead.\n'
        printf 'set -u\n\n'
        printf '# Remove the shim directory from PATH -- EVERY occurrence, not just a\n'
        printf '# leading one. A prefix-only strip leaves the shim reachable when the\n'
        printf '# directory sits mid-PATH, and then the lookup below finds this very\n'
        printf '# script: exec-ing it recurses until the container dies, which looks\n'
        printf '# exactly like a hang.\n'
        printf '_ha_paseo_strip_path() {\n'
        printf '    local out="" part\n'
        printf '    local IFS=:\n'
        printf '    for part in $PATH; do\n'
        printf '        [[ "$part" == "%s" ]] && continue\n' "$SHIM_DIR"
        printf '        out="${out:+$out:}$part"\n'
        printf '    done\n'
        printf '    PATH="$out"\n'
        printf '}\n'
        printf '_ha_paseo_strip_path\n'
        printf 'export PATH\n\n'
        if [[ -n "$target" ]]; then
            printf '# The exact binary this shim wraps, given explicitly in the add-on\n'
            printf '# configuration. No PATH lookup, so this cannot resolve back to the\n'
            printf '# shim itself.\n'
            printf 'REAL=%q\n' "$target"
            printf 'export REAL\n\n'
        else
            printf '# No explicit target, so resolve by name with the shim directory\n'
            printf '# removed from PATH. Prefer `target` -- it removes this guesswork.\n'
            printf 'REAL="$(command -v %s 2>/dev/null || true)"\n' "$name"
            printf 'export REAL\n\n'
            printf 'case "$REAL" in\n'
            printf '  %s/*|"")\n' "$SHIM_DIR"
            printf '    echo "ha-paseo shim %s: cannot find the real binary (PATH=$PATH)" >&2\n' "$name"
            printf '    exit 127 ;;\n'
            printf 'esac\n\n'
        fi
        if [[ -n "$passthrough" ]]; then
            printf '# Bypass the wrapper for probe-style invocations.\n'
            printf 'case "${1:-}" in\n'
            printf '  %s)\n' "$passthrough"
            printf '    if [[ -n "$REAL" ]]; then exec "$REAL" "$@"; fi ;;\n'
            printf 'esac\n\n'
        fi
        if [[ -n "$script_body" ]]; then
            # Full control. "$@" and $REAL are in scope.
            printf '%s\n' "$script_body"
        elif [[ -n "$env_from" ]]; then
            # Set environment, then run the ORIGINAL command. This is the shape
            # a proxy wants: `teamclaude run` would insert another process and
            # write its own chatter to stdout, which corrupts the stdio protocol
            # Paseo speaks to agents over.
            printf '# Evaluate environment from a helper, then exec the real binary.\n'
            if [[ -n "$require_port" ]]; then
                # A proxy helper may emit its exports whether or not the proxy
                # is up: `teamclaude env` prints ANTHROPIC_BASE_URL and merely
                # *comments* that nothing is listening. Evaluating that points
                # the command at a dead port, which hangs.
                #
                # A bare TCP connect rather than a status subcommand: the latter
                # spawns a process and queries the proxy's HTTP layer, so it
                # blocks for as long as the proxy is busy. A connect is answered
                # from the listen backlog regardless of what it is doing.
                printf '# Only consult the helper when something is listening on %s;\n' "$require_port"
                printf '# otherwise the exports would point at a dead port.\n'
                printf 'if (exec 3<>/dev/tcp/127.0.0.1/%s) 2>/dev/null; then\n' "$require_port"
                printf '    exec 3<&- 3>&-\n'
                printf '    if out="$(%s 2>/dev/null)"; then\n' "$env_from"
                printf '        eval "$out"\n'
                printf '    fi\n'
                printf 'fi\n'
            else
                printf 'if out="$(%s 2>/dev/null)"; then\n' "$env_from"
                printf '    eval "$out"\n'
                printf 'fi\n'
            fi
            printf 'if [[ -z "$REAL" ]]; then\n'
            printf '    echo "shim %s: cannot find the real binary on PATH" >&2\n' "$name"
            printf '    exit 127\n'
            printf 'fi\n'
            printf 'exec "$REAL" "$@"\n'
        else
            printf 'exec %s "$@"\n' "$command_line"
        fi
    } > "${SHIM_DIR}/${name}"

    chmod 0755 "${SHIM_DIR}/${name}"
    count=$(( count + 1 ))
    if [[ -n "$script_body" ]]; then
        log "shim '${name}' (wrapping ${target:-$name}) -> custom script"
    elif [[ -n "$env_from" ]]; then
        log "shim '${name}' -> env from '${env_from}', then ${target:-the real $name}"
    else
        log "shim '${name}' -> ${command_line}"
    fi
done < <(jq -c '.[]? | select(type == "object")' <<<"$SHIMS_JSON" 2>/dev/null)

if (( count > 0 )); then
    log "${count} shim(s) installed in ${SHIM_DIR} (first on PATH)"
fi
